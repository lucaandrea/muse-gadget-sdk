# Companion uses existing Muse pairing and Wi-Fi; credentials are provisioned in NVS.
CONFIG_MUSE_POCKET=y
CONFIG_MUSE_REFINED_UI=y
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# Leave internal RAM for the companion socket and OTA health checks.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_pocket.csv"

CONFIG_LV_USE_QRCODE=y
